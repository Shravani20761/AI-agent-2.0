# ── Domain ───────────────────────────────────────────────────
# Your VPS domain. Used in nginx/default.conf (replace REPLACE_WITH_YOUR_DOMAIN)
# and as the LIVEKIT_URL returned to the browser.
DOMAIN=your-vps-domain.com

# ── LiveKit ───────────────────────────────────────────────────
# MUST match the keys block in livekit.yaml
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# External URL for the browser. Nginx terminates TLS on 7880 → LiveKit.
LIVEKIT_URL=wss://your-vps-domain.com:7880

# ── Neon PostgreSQL ───────────────────────────────────────────
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxx.neon.tech/neondb?sslmode=require

# ── Backend ───────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-min-32-chars
ADMIN_EMAIL=admin@seagull.com
ADMIN_PASSWORD=admin123
FRONTEND_URL=https://your-vps-domain.com

# ── Gemini Live ───────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Aoede

# ── Sarvam + Deepseek ─────────────────────────────────────────
SARVAM_API_KEY=
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=priya
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_MODEL=deepseek/deepseek-chat
