# Backend API base URL.
# - Use "/api" (default) to rely on a same-origin reverse proxy (Caddy, nginx, etc.)
# - Use a full URL (e.g. "http://localhost:3001") to call the backend directly during dev
VITE_API_URL=/api

# Display label in the CRM call widget. The actual room URL comes from the backend token.
# Self-hosted example: wss://your-vps-ip-or-domain:7880
VITE_LIVEKIT_URL=
