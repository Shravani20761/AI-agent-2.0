# Backend API base URL.
# - Use "/api" (default) to rely on a same-origin reverse proxy (Caddy, nginx, etc.)
# - Use a full URL (e.g. "http://localhost:3001") to call the backend directly during dev
VITE_API_URL=/api

# LiveKit VoiceKit — set to enable real WebRTC calls instead of demo simulation
# Leave blank to use demo mode (Web Speech API, no server needed)
VITE_LIVEKIT_URL=
