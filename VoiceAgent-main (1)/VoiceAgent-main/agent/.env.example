# LiveKit server credentials.
# Cloud: https://livekit.io → create a project → copy these values.
# Self-hosted: LIVEKIT_URL=wss://your-vps-ip-or-domain:7880
# The key and secret must match infra/livekit.yaml. Inside Docker Compose, the worker
# can use ws://livekit:7880 while browsers keep the public wss URL.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# Demo backend used for CRM tool calls and usage reporting.
DEMO_BACKEND_URL=http://localhost:3001

# Gemini Live. Leave blank to keep GEMINI_LIVE rooms model-less.
# The worker does not fall back to another provider.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_LIVE_VOICE=Aoede

# Sarvam speech APIs and the DeepSeek chat model used by SARVAM_PIPELINE.
# Both keys are required for that mode. OpenAI Realtime is not a substitute.
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER=anushka
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
