# LiveKit server credentials — get these from https://livekit.io (free plan works)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# OpenAI API key — needs access to gpt-4o-realtime-preview
OPENAI_API_KEY=replace-with-openai-api-key
