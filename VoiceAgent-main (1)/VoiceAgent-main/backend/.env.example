DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@seagull.com
ADMIN_PASSWORD=changeme123
PORT=3001
FRONTEND_URL=http://localhost:5173

# Dograh Voice Agent Orchestrator Config (If triggering outbound API actions)
DOGRAH_API_URL=http://localhost:3010
DOGRAH_API_KEY=replace-with-your-dograh-api-key

# LiveKit VoiceKit Config (browser-based demo calls — optional)
# Sign up free at https://livekit.io → create a project → copy these values
# If not set, the widget runs in simulation/demo mode using Web Speech API
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

