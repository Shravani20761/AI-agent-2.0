DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Neon pooler URLs cannot take migration locks. Set DIRECT_URL to the non-pooler connection for prisma migrate deploy.
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_EMAIL=admin@seagull.com
ADMIN_PASSWORD=changeme123
PORT=3001
FRONTEND_URL=http://localhost:5173

# Dograh Voice Agent Orchestrator Config (If triggering outbound API actions)
DOGRAH_API_URL=http://localhost:3010
DOGRAH_API_KEY=replace-with-your-dograh-api-key

# LiveKit VoiceKit Config (browser-based demo calls — optional)
# Cloud: https://livekit.io → create a project → copy these values.
# Self-hosted: use the same key and secret as infra/livekit.yaml, for example
# LIVEKIT_URL=wss://your-vps-ip-or-domain:7880
# Required for /api/voicekit/token and /api/demo/call/start. The secret stays on the server.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=replace-with-livekit-api-key
LIVEKIT_API_SECRET=replace-with-livekit-api-secret

# Shown on the cost dashboard as configured/missing. The voice worker reads the same names from agent/.env.
GEMINI_API_KEY=
SARVAM_API_KEY=
DEEPSEEK_API_KEY=

# Browser origin for the cost dashboard. CRM origin stays FRONTEND_URL.
COST_DASHBOARD_URL=http://localhost:5174

