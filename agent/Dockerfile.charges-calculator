FROM node:22

# LiveKit agents pipeline requires ffmpeg for audio encode/decode
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy only package.json (NOT package-lock.json).
# The lockfile was generated on Windows, so npm would install
# win32 native binaries. A fresh npm install on Linux resolves
# the correct linux-x64-gnu variants automatically.
COPY package.json ./
RUN npm install --omit=dev

# Copy source files (no .env — env vars come from docker-compose)
COPY agent.js ./
COPY modes ./modes/
COPY lib ./lib/
COPY prompts ./prompts/

# start mode (not dev) — no deprecated lk agent dev wrapper needed in container
CMD ["node", "agent.js", "start"]
